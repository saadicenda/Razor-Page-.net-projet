@page
@model TPIntroRazor.Pages.CalculModel

@{
    ViewData["Title"] = "Calculateur d'âge";
}

<div class="container mt-4" style="max-width: 450px;">

    <h2 class="mb-3">Calculateur d'âge</h2>

    <form method="post">

        <div class="mb-3">
            <label asp-for="Nom" class="form-label">Nom</label>
            <input asp-for="Nom" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AnneeNaissance" class="form-label">
                Année de naissance
            </label>

            <input asp-for="AnneeNaissance"
                   type="number"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Calculer mon âge
        </button>

    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info mt-4">
            @Model.Message
        </div>
    }

</div>